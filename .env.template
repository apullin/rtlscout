# Copy this file to .env and fill in your API keys.
# The agent loads keys via python-dotenv from .env automatically.

# DeepInfra (for deepinfra:* open-source models)
DEEPINFRA_API_KEY=your-deepinfra-key-here

# Anthropic (for anthropic:* models)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenRouter (for openrouter:* models — GPT, Gemini, GLM, Kimi, MiniMax, etc.)
OPENROUTER_API_KEY=your-openrouter-key-here

# Local / self-hosted OpenAI-compatible server (for local:* models — vLLM, Ollama, llama.cpp, LM Studio, ...).
# LOCAL_BASE_URL is the server's /v1 endpoint; LOCAL_API_KEY is optional (most local servers accept any value).
#   vLLM:       http://localhost:8000/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   llama.cpp:  http://localhost:8080/v1
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=not-needed

# Spire compilation timeout in seconds (default when not set: 60)
SPIREHDL_TIMEOUT=600
